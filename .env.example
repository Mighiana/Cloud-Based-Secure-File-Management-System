# Copy to .env for the local docker compose demo. Never commit .env.
# SQL Server requires 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Optional: run ClamAV as a second scanner (default true). If false, only basic validation runs.
CLAMAV_ENABLED=true
# Optional: deploy the reconstructed upload-scan Lambda into LocalStack (needs the Docker socket).
UPLOAD_SCAN_LAMBDA=true
