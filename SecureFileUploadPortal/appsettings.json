{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },

  "Storage": {
    "Region": "eu-central-1",
    "QuarantineBucketName": "",
    "ApprovedBucketName": "",
    "ServiceUrl": "",
    "PublicServiceUrl": "",
    "ForcePathStyle": false,
    "ServerSideEncryption": "AES256",
    "KmsKeyId": "",
    "PresignedUrlMinutes": 15,
    "StorageQuotaMB": 1000
  },

  "CloudTrail": {
    "BucketName": "",
    "AccountId": ""
  },

  "Upload": {
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".txt", ".png", ".jpg", ".jpeg" ]
  },

  "Validation": {
    "RunWorker": true,
    "PollSeconds": 5,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 30,
    "StaleAfterMinutes": 5,
    "ClamAv": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 60
    }
  },

  "Seed": {
    "AdminEmail": "",
    "AdminName": "Administrator",
    "AdminPassword": ""
  }
}
