@model FileListViewModel
@{
    ViewData["Title"] = Model.ShowAllUsers ? "All Files" : "My Files";
}
<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h2 class="page-title">@ViewData["Title"]</h2>
        <p class="page-subtitle mb-0">@Model.Files.Count file(s) · @FormatHelpers.Bytes(Model.Files.Sum(f => f.SizeBytes))</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanSeeAllUsers)
        {
            <div class="btn-group">
                <a asp-action="List" asp-route-all="false" class="btn btn-sm @(Model.ShowAllUsers ? "btn-outline-secondary" : "btn-secondary")">My files</a>
                <a asp-action="List" asp-route-all="true" class="btn btn-sm @(Model.ShowAllUsers ? "btn-secondary" : "btn-outline-secondary")">All users</a>
            </div>
        }
        <a asp-action="Upload" class="btn btn-primary btn-sm"><i class="fas fa-cloud-arrow-up me-1"></i>Upload</a>
    </div>
</div>

<div class="card"><div class="card-body p-0">
    @if (!Model.Files.Any())
    {
        <p class="text-muted p-4 mb-0">No files yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-end">Size</th>
                        @if (Model.ShowAllUsers) { <th>Owner</th> }
                        <th>Uploaded (UTC)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Files)
                    {
                        <tr>
                            <td class="text-truncate" style="max-width: 320px;"><i class="fas fa-file-lines me-2 text-muted"></i>@f.FileName</td>
                            <td class="text-muted small text-truncate" style="max-width: 200px;" title="@f.ContentType">@f.ContentType</td>
                            <td class="text-end text-nowrap">@FormatHelpers.Bytes(f.SizeBytes)</td>
                            @if (Model.ShowAllUsers) { <td>@f.OwnerEmail</td> }
                            <td class="text-nowrap">@f.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Download" asp-route-id="@f.Id" class="btn btn-outline-success btn-sm"><i class="fas fa-download me-1"></i>Download</a>
                                <form asp-action="Delete" asp-route-id="@f.Id" asp-route-all="@Model.ShowAllUsers" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this file permanently?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm ms-1"><i class="fas fa-trash me-1"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div></div>
<p class="text-muted small mt-2">Downloads use pre-signed S3 URLs that expire after a few minutes.</p>
