@model FileListViewModel
@{
    ViewData["Title"] = Model.ShowAllUsers ? "All Files" : "My Files";
}
<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h2 class="page-title">@ViewData["Title"]</h2>
        <p class="page-subtitle mb-0">@Model.Files.Count file(s) · @FormatHelpers.Bytes(Model.Files.Sum(f => f.SizeBytes))
            @if (Model.StatusFilter is { } filter)
            {
                <a asp-action="List" asp-route-all="@Model.ShowAllUsers" class="badge @AuditDisplay.StatusBadge(filter) ms-2 text-decoration-none" title="Clear filter">@filter <i class="fas fa-xmark ms-1"></i></a>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanSeeAllUsers)
        {
            <div class="btn-group">
                <a asp-action="List" asp-route-all="false" class="btn btn-sm @(Model.ShowAllUsers ? "btn-outline-secondary" : "btn-secondary")">My files</a>
                <a asp-action="List" asp-route-all="true" class="btn btn-sm @(Model.ShowAllUsers ? "btn-secondary" : "btn-outline-secondary")">All users</a>
            </div>
        }
        <a asp-action="Upload" class="btn btn-primary btn-sm"><i class="fas fa-cloud-arrow-up me-1"></i>Upload</a>
    </div>
</div>

<div class="card" data-auto-refresh="@(Model.HasFilesInProgress ? "5" : null)"><div class="card-body p-0">
    @if (!Model.Files.Any())
    {
        <p class="text-muted p-4 mb-0">No files yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Security</th>
                        <th class="text-end">Size</th>
                        @if (Model.ShowAllUsers) { <th>Owner</th> }
                        <th>Uploaded (UTC)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Files)
                    {
                        <tr>
                            <td class="text-truncate mw-320"><i class="fas fa-file-lines me-2 text-muted"></i><a asp-action="Details" asp-route-id="@f.Id">@f.FileName</a></td>
                            <td><span class="badge @AuditDisplay.StatusBadge(f.Status)"><i class="fas @AuditDisplay.StatusIcon(f.Status) me-1"></i>@f.Status</span></td>
                            <td class="text-end text-nowrap">@FormatHelpers.Bytes(f.SizeBytes)</td>
                            @if (Model.ShowAllUsers) { <td>@f.OwnerEmail</td> }
                            <td class="text-nowrap">@f.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                @if (f.Status == FileSecurityStatus.Approved)
                                {
                                    <a asp-action="Download" asp-route-id="@f.Id" class="btn btn-outline-success btn-sm"><i class="fas fa-download me-1"></i>Download</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Only approved files can be downloaded"><i class="fas fa-lock me-1"></i>Download</button>
                                }
                                <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-info btn-sm ms-1"><i class="fas fa-circle-info"></i><span class="visually-hidden">Details</span></a>
                                <form asp-action="Delete" asp-route-id="@f.Id" asp-route-all="@Model.ShowAllUsers" method="post" class="d-inline" data-confirm="Delete this file permanently?">
                                    <button type="submit" class="btn btn-outline-danger btn-sm ms-1"><i class="fas fa-trash"></i><span class="visually-hidden">Delete</span></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div></div>
<p class="text-muted small mt-2">New uploads stay in quarantine until validation approves them. Downloads use pre-signed S3 URLs that expire after a few minutes.</p>
