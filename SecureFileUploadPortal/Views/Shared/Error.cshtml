@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}
<div class="card auth-card p-4 text-center">
    <div class="brand-icon mb-2"><i class="fas fa-triangle-exclamation"></i></div>
    <h1 class="h4">Something went wrong</h1>
    <p class="text-muted">The request could not be completed. The error has been logged.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-3">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back to dashboard</a>
</div>
