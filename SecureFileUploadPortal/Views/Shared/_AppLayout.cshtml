@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => controller == c && action == a ? "active" : "";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Secure File Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <nav class="sidebar"><div class="sidebar-inner">
        <div class="d-flex align-items-center justify-content-between justify-content-lg-center">
            <div class="brand fs-5"><i class="fas fa-shield-halved me-2"></i>Secure Portal</div>
            <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarNav"
                    aria-controls="sidebarNav" aria-expanded="false" aria-label="Toggle navigation"><i class="fas fa-bars"></i></button>
        </div>
        <div id="sidebarNav" class="collapse sidebar-nav">

        <a class="nav-link-item @Active("Home", "Index")" asp-controller="Home" asp-action="Index"><i class="fas fa-house me-2"></i>My Dashboard</a>
        <a class="nav-link-item @Active("File", "List")" asp-controller="File" asp-action="List"><i class="fas fa-folder-open me-2"></i>My Files</a>
        <a class="nav-link-item @Active("File", "Upload")" asp-controller="File" asp-action="Upload"><i class="fas fa-cloud-arrow-up me-2"></i>Upload</a>

        @if (isAdmin)
        {
            <div class="nav-section">Administration</div>
            <a class="nav-link-item @Active("Admin", "Index")" asp-controller="Admin" asp-action="Index"><i class="fas fa-gauge-high me-2"></i>Admin Dashboard</a>
            <a class="nav-link-item @Active("Admin", "Users")" asp-controller="Admin" asp-action="Users"><i class="fas fa-users me-2"></i>Users &amp; Roles</a>
            <a class="nav-link-item @Active("Admin", "Audit")" asp-controller="Admin" asp-action="Audit"><i class="fas fa-list-check me-2"></i>Audit Log</a>
            <a class="nav-link-item @Active("Admin", "Integrity")" asp-controller="Admin" asp-action="Integrity"><i class="fas fa-link me-2"></i>Audit Integrity</a>
            <a class="nav-link-item @Active("Admin", "Logs")" asp-controller="Admin" asp-action="Logs"><i class="fas fa-scroll me-2"></i>CloudTrail Logs</a>
            <a class="nav-link-item @Active("Admin", "Reports")" asp-controller="Admin" asp-action="Reports"><i class="fas fa-chart-column me-2"></i>Reports</a>
            <a class="nav-link-item @Active("Admin", "Settings")" asp-controller="Admin" asp-action="Settings"><i class="fas fa-gear me-2"></i>Configuration</a>
        }

        <div class="user-box">
            <div class="fw-semibold text-white text-truncate">@User.Identity?.Name</div>
            <div class="text-muted text-truncate small">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
            <span class="badge @(isAdmin ? "bg-warning text-dark" : "bg-info text-dark") mt-1">@(isAdmin ? Roles.Admin : Roles.User)</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100"><i class="fas fa-right-from-bracket me-1"></i>Sign out</button>
            </form>
        </div>
        </div>
    </div></nav>
    <main class="main-content">
        <partial name="_StatusMessages" />
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
