@if (TempData["Success"] is string success)
{
    <div class="alert alert-dark-success d-flex align-items-center" role="status"><i class="fas fa-circle-check me-2"></i>@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-dark-danger d-flex align-items-center" role="alert"><i class="fas fa-triangle-exclamation me-2"></i>@error</div>
}
