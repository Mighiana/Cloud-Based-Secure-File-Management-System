@{
    var code = ViewData["StatusCode"] as int? ?? 0;
    ViewData["Title"] = code.ToString();
    Layout = "_AuthLayout";
    var message = code switch
    {
        404 => "The page or file you requested was not found, or you don't have access to it.",
        429 => "Too many requests. Please wait a minute and try again.",
        _ => "The request could not be completed.",
    };
}
<div class="card auth-card p-4 text-center">
    <div class="brand-icon mb-2"><i class="fas fa-circle-info"></i></div>
    <h1 class="h4">@code</h1>
    <p class="text-muted">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back to dashboard</a>
</div>
