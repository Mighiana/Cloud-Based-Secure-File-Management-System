@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}
<div class="card auth-card p-4 text-center">
    <div class="brand-icon mb-2 text-danger"><i class="fas fa-ban"></i></div>
    <h1 class="h4">Access denied</h1>
    <p class="text-muted">Your role does not allow access to this page. The attempt has been recorded in the audit log.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back to dashboard</a>
</div>
