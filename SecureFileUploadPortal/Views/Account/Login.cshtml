@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<div class="card auth-card p-4">
    <div class="text-center mb-3">
        <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
        <h1 class="h4 mt-2 mb-0">Secure File Portal</h1>
        <p class="text-muted small mb-0">Sign in to manage your files</p>
    </div>
    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-dark-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-right-to-bracket me-1"></i>Sign in</button>
    </form>
    <p class="text-muted small mt-3 mb-0 text-center">Accounts are created by an administrator. Five failed attempts lock the account for 15 minutes.</p>
</div>
