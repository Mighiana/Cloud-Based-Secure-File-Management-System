@model UsersViewModel
@{
    ViewData["Title"] = "Users & Roles";
}
<h2 class="page-title">Users &amp; roles</h2>
<p class="page-subtitle">Accounts are stored in SQL Server with PBKDF2 password hashes. Role or status changes take effect on the user's next request.</p>

<div class="row g-3">
    <div class="col-12">
        <div class="card"><div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr><th>User</th><th>Role</th><th>Status</th><th class="text-end">Files</th><th>Last sign-in (UTC)</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var isSelf = u.Id == Model.CurrentUserId;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@u.DisplayName @if (isSelf) { <span class="badge bg-secondary ms-1">you</span> }</div>
                                    <div class="text-muted small">@u.Email</div>
                                </td>
                                <td><span class="badge @(u.Role == Roles.Admin ? "bg-warning text-dark" : "bg-info text-dark")">@u.Role</span></td>
                                <td>
                                    @if (!u.IsActive) { <span class="badge bg-secondary">Inactive</span> }
                                    else if (u.IsLockedOut) { <span class="badge bg-danger">Locked out</span> }
                                    else { <span class="badge bg-success">Active</span> }
                                </td>
                                <td class="text-end">@u.FileCount</td>
                                <td class="text-nowrap small">@(u.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                                <td class="text-end text-nowrap">
                                    @if (!isSelf)
                                    {
                                        <form asp-action="SetRole" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="role" value="@(u.Role == Roles.Admin ? Roles.User : Roles.Admin)" />
                                            <button class="btn btn-outline-warning btn-sm">Make @(u.Role == Roles.Admin ? Roles.User : Roles.Admin)</button>
                                        </form>
                                        <form asp-action="SetActive" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="active" value="@((!u.IsActive).ToString().ToLowerInvariant())" />
                                            <button class="btn btn-sm ms-1 @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div></div>
    </div>
    <div class="col-12">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Create user</h5>
            <form asp-action="CreateUser" method="post">
                @* The tag helper emits an inline style when valid, which the CSP blocks. *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-dark-danger py-2 small"></div>
                }
                <div class="row g-3 align-items-start">
                <div class="col-md-6 col-xl-3">
                    <label asp-for="NewUser.Email" class="form-label">E-mail</label>
                    <input asp-for="NewUser.Email" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-6 col-xl-3">
                    <label asp-for="NewUser.DisplayName" class="form-label"></label>
                    <input asp-for="NewUser.DisplayName" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-6 col-xl-2">
                    <label asp-for="NewUser.Password" class="form-label">Initial password</label>
                    <input asp-for="NewUser.Password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least @UserService.MinPasswordLength characters.</div>
                </div>
                <div class="col-md-3 col-xl-2">
                    <label asp-for="NewUser.Role" class="form-label">Role</label>
                    <select asp-for="NewUser.Role" class="form-select" asp-items="@(new SelectList(Roles.All))"></select>
                </div>
                <div class="col-md-3 col-xl-2">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-user-plus me-1"></i>Create user</button>
                </div>
                </div>
            </form>
        </div></div>
    </div>
</div>
