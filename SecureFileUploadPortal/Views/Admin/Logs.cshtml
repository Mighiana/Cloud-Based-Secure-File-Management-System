@model CloudTrailViewModel
@{
    ViewData["Title"] = "CloudTrail Logs";
}
<h2 class="page-title">AWS CloudTrail logs</h2>
<p class="page-subtitle">Infrastructure-level API activity delivered by CloudTrail to a separate S3 bucket. Complements the application audit log.</p>

@if (!Model.IsConfigured)
{
    <div class="alert alert-dark-info">
        <i class="fas fa-circle-info me-2"></i>CloudTrail is not configured. Set <code>CloudTrail:BucketName</code> and <code>CloudTrail:AccountId</code> to list log files here.
    </div>
}
else if (Model.Error is not null)
{
    <div class="alert alert-dark-danger">@Model.Error</div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-sm mb-0">
                <thead><tr><th>Log file</th><th class="text-end">Size</th><th>Delivered (UTC)</th><th></th></tr></thead>
                <tbody>
                    @if (!Model.Logs.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No log files found.</td></tr>
                    }
                    @foreach (var l in Model.Logs)
                    {
                        <tr>
                            <td class="mono text-truncate" style="max-width: 520px;">@l.Key</td>
                            <td class="text-end">@FormatHelpers.Bytes(l.SizeBytes)</td>
                            <td class="text-nowrap">@l.LastModifiedUtc?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end"><a asp-action="ViewLog" asp-route-key="@l.Key" class="btn btn-outline-info btn-sm">Download JSON</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div></div>
}
