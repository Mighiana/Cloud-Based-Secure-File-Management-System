@model AuditViewModel
@{
    ViewData["Title"] = "Audit Log";
    var f = Model.Filter;
}
<h2 class="page-title">Audit log</h2>
<p class="page-subtitle">Application-level user activity persisted in the <code>AuditLogs</code> table. @Model.TotalCount matching event(s).</p>

<form method="get" class="card mb-3"><div class="card-body row g-2 align-items-end">
    <div class="col-md-3">
        <label class="form-label small" for="action">Action</label>
        <select name="action" id="action" class="form-select form-select-sm">
            <option value="">Any</option>
            @foreach (var a in Model.KnownActions)
            {
                <option value="@a" selected="@(a == f.Action)">@AuditDisplay.Label(a)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small" for="user">User e-mail contains</label>
        <input name="user" id="user" value="@f.User" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2">
        <label class="form-label small" for="succeeded">Outcome</label>
        <select name="succeeded" id="succeeded" class="form-select form-select-sm">
            <option value="">Any</option>
            <option value="true" selected="@(f.Succeeded == true)">Succeeded</option>
            <option value="false" selected="@(f.Succeeded == false)">Failed / denied</option>
        </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="fas fa-filter me-1"></i>Filter</button>
        <a asp-action="Audit" class="btn btn-outline-secondary btn-sm">Reset</a>
        <a asp-action="DownloadReport" asp-route-type="audit" class="btn btn-outline-info btn-sm ms-auto"><i class="fas fa-file-csv me-1"></i>Export CSV</a>
    </div>
</div></form>

<div class="card"><div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm mb-0">
            <thead><tr><th>Time (UTC)</th><th>Action</th><th>User</th><th>Target</th><th>Details</th><th>IP</th></tr></thead>
            <tbody>
                @if (!Model.Entries.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No events match the filter.</td></tr>
                }
                @foreach (var a in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap small">@a.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><partial name="_AuditRow" model="a" /></td>
                        <td class="text-truncate" style="max-width: 220px;">@a.UserEmail</td>
                        <td class="text-truncate" style="max-width: 240px;">@a.Target</td>
                        <td class="text-truncate text-muted small" style="max-width: 240px;">@a.Details</td>
                        <td class="mono small">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div></div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page @f.Page of @Model.TotalPages</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(f.Page <= 1 ? "disabled" : "")" asp-action="Audit"
               asp-route-action="@f.Action" asp-route-user="@f.User" asp-route-succeeded="@f.Succeeded" asp-route-page="@(f.Page - 1)">Previous</a>
            <a class="btn btn-outline-secondary btn-sm @(f.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Audit"
               asp-route-action="@f.Action" asp-route-user="@f.User" asp-route-succeeded="@f.Succeeded" asp-route-page="@(f.Page + 1)">Next</a>
        </div>
    </nav>
}
