@model SettingsViewModel
@{
    ViewData["Title"] = "Configuration";
}
<h2 class="page-title">Configuration</h2>
<p class="page-subtitle">Effective runtime configuration (read-only). Values come from <code>appsettings.json</code>, environment variables or user-secrets; secrets are never displayed.</p>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title"><i class="fab fa-aws me-2"></i>Object storage</h5>
            <dl class="row mb-0 small">
                <dt class="col-5">Endpoint</dt><dd class="col-7 mono">@Model.StorageEndpoint</dd>
                <dt class="col-5">Quarantine bucket</dt><dd class="col-7 mono">@Model.QuarantineBucket</dd>
                <dt class="col-5">Approved bucket</dt><dd class="col-7 mono">@Model.ApprovedBucket</dd>
                <dt class="col-5">Region</dt><dd class="col-7 mono">@Model.Region</dd>
                <dt class="col-5">Server-side encryption</dt><dd class="col-7 mono">@Model.ServerSideEncryption @(Model.KmsKeyConfigured ? "(customer KMS key)" : "")</dd>
                <dt class="col-5">Pre-signed URL lifetime</dt><dd class="col-7">@Model.PresignedUrlMinutes min</dd>
                <dt class="col-5">Credentials</dt><dd class="col-7">@(Model.StaticCredentials ? "Static access key (configured)" : "AWS default credential chain")</dd>
                <dt class="col-5">CloudTrail bucket</dt><dd class="col-7 mono">@(string.IsNullOrEmpty(Model.CloudTrailBucket) ? "not configured" : Model.CloudTrailBucket)</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title"><i class="fas fa-upload me-2"></i>Upload policy</h5>
            <dl class="row mb-0 small">
                <dt class="col-5">Maximum size</dt><dd class="col-7">@Model.MaxFileSizeMB MB</dd>
                <dt class="col-5">Allowed extensions</dt><dd class="col-7 mono">@string.Join(" ", Model.AllowedExtensions)</dd>
                <dt class="col-5">Validation worker</dt><dd class="col-7">@(Model.ValidationWorkerInProcess ? "in this process" : "external process")</dd>
                <dt class="col-5">ClamAV</dt><dd class="col-7 mono">@(Model.ClamAvEnabled ? $"enabled ({Model.ClamAvEndpoint})" : "disabled (basic validation only)")</dd>
                <dt class="col-5">Scan attempts before quarantine</dt><dd class="col-7">@Model.ScanMaxAttempts</dd>
                <dt class="col-5">Environment</dt><dd class="col-7 mono">@Model.Environment</dd>
            </dl>
        </div></div>
    </div>
</div>
