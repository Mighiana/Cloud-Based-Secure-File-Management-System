@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2 class="page-title">Security overview</h2>
<p class="page-subtitle">Live figures from the SQL Server database and audit log.</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Users</div><div class="stat-value">@Model.TotalUsers</div><small class="text-muted">@Model.ActiveUsers active</small></div>
            <i class="fas fa-users stat-icon text-info"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Files</div><div class="stat-value">@Model.TotalFiles</div><small class="text-muted">@FormatHelpers.Bytes(Model.StorageBytes) in S3</small></div>
            <i class="fas fa-file stat-icon text-primary"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Audit events (24h)</div><div class="stat-value">@Model.Events24h</div><small class="text-muted">all actions</small></div>
            <i class="fas fa-list-check stat-icon text-success"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Failed sign-ins (24h)</div><div class="stat-value @(Model.FailedLogins24h > 0 ? "text-danger" : "")">@Model.FailedLogins24h</div><small class="text-muted">incl. lockouts</small></div>
            <i class="fas fa-user-lock stat-icon text-danger"></i>
        </div></div>
    </div>
</div>

<h5 class="section-title"><i class="fas fa-shield-virus me-2"></i>File security pipeline</h5>
<div class="row g-3 mb-4">
    @foreach (var status in Enum.GetValues<FileSecurityStatus>())
    {
        <div class="col-6 col-md-4 col-xl">
            <div class="card stat-card h-100"><div class="card-body">
                <div class="stat-label"><span class="badge @AuditDisplay.StatusBadge(status) me-1"><i class="fas @AuditDisplay.StatusIcon(status)"></i></span>@status</div>
                <div class="stat-value">@Model.StatusCount(status)</div>
            </div></div>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Failed sign-ins (7d)</div><div class="stat-value @(Model.FailedLogins7d > 0 ? "text-danger" : "")">@Model.FailedLogins7d</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Blocked downloads (7d)</div><div class="stat-value @(Model.BlockedDownloads7d > 0 ? "text-warning" : "")">@Model.BlockedDownloads7d</div><small class="text-muted">not approved / not owner</small></div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Upload rejections (7d)</div><div class="stat-value @(Model.UploadRejections7d > 0 ? "text-warning" : "")">@Model.UploadRejections7d</div><small class="text-muted">upload + validation</small></div></div></div>
    <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Scan failures (7d)</div><div class="stat-value @(Model.ScanFailures7d > 0 ? "text-danger" : "")">@Model.ScanFailures7d</div><small class="text-muted">errors + quarantines</small></div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Activity – last 7 days</h5>
            <div class="chart-box"><canvas id="activityChart" data-days="@System.Text.Json.JsonSerializer.Serialize(Model.Last7Days, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))"></canvas></div>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Recent security events</h5>
                <a asp-action="Integrity" class="btn btn-outline-info btn-sm"><i class="fas fa-link me-1"></i>Verify chain</a>
            </div>
            @if (!Model.RecentSecurityEvents.Any())
            {
                <p class="text-muted mb-0">No failed or blocked actions recorded.</p>
            }
            else
            {
                <ul class="list-group list-group-flush list-dark">
                    @foreach (var e in Model.RecentSecurityEvents)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between"><partial name="_AuditRow" model="e" /><span class="text-muted small text-nowrap">@e.TimestampUtc.ToString("MMM dd HH:mm")</span></div>
                            <small class="text-muted text-truncate d-block">@e.UserEmail · @e.Target</small>
                        </li>
                    }
                </ul>
            }
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Recent audit events</h5>
                <a asp-action="Audit" class="btn btn-outline-info btn-sm">Full audit log</a>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-sm mb-0">
                    <tbody>
                        @foreach (var a in Model.RecentEvents)
                        {
                            <tr>
                                <td class="text-nowrap text-muted small">@a.TimestampUtc.ToString("MMM dd HH:mm:ss")</td>
                                <td><partial name="_AuditRow" model="a" /></td>
                                <td class="text-truncate mw-180">@a.UserEmail</td>
                                <td class="text-truncate text-muted small mw-200">@a.Target</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Latest uploads</h5>
                <a asp-controller="File" asp-action="List" asp-route-all="true" class="btn btn-outline-primary btn-sm">All files</a>
            </div>
            @if (!Model.RecentFiles.Any())
            {
                <p class="text-muted mb-0">No files uploaded.</p>
            }
            else
            {
                <ul class="list-group list-group-flush list-dark">
                    @foreach (var f in Model.RecentFiles)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between"><a asp-controller="File" asp-action="Details" asp-route-id="@f.Id" class="text-truncate me-2">@f.FileName</a><span class="text-muted small text-nowrap">@FormatHelpers.Bytes(f.SizeBytes)</span></div>
                            <small class="text-muted">@f.OwnerEmail · @f.UploadedAtUtc.ToString("MMM dd HH:mm")</small> <span class="badge @AuditDisplay.StatusBadge(f.Status)">@f.Status</span>
                        </li>
                    }
                </ul>
            }
        </div></div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
