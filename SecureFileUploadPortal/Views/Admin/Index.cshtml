@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2 class="page-title">Security overview</h2>
<p class="page-subtitle">Live figures from the SQL Server database and audit log.</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Users</div><div class="stat-value">@Model.TotalUsers</div><small class="text-muted">@Model.ActiveUsers active</small></div>
            <i class="fas fa-users stat-icon text-info"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Files</div><div class="stat-value">@Model.TotalFiles</div><small class="text-muted">@FormatHelpers.Bytes(Model.StorageBytes) in S3</small></div>
            <i class="fas fa-file stat-icon text-primary"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Audit events (24h)</div><div class="stat-value">@Model.Events24h</div><small class="text-muted">all actions</small></div>
            <i class="fas fa-list-check stat-icon text-success"></i>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex justify-content-between align-items-center">
            <div><div class="stat-label">Failed sign-ins (24h)</div><div class="stat-value @(Model.FailedLogins24h > 0 ? "text-danger" : "")">@Model.FailedLogins24h</div><small class="text-muted">incl. lockouts</small></div>
            <i class="fas fa-user-lock stat-icon text-danger"></i>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Activity – last 7 days</h5>
            <div style="position: relative; height: 260px;"><canvas id="activityChart"></canvas></div>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Most active users (7 days)</h5>
            @if (!Model.TopUsers.Any())
            {
                <p class="text-muted mb-0">No activity recorded.</p>
            }
            else
            {
                <ul class="list-group list-group-flush list-dark">
                    @foreach (var u in Model.TopUsers)
                    {
                        <li class="list-group-item d-flex justify-content-between"><span class="text-truncate">@u.Email</span><span class="badge bg-primary">@u.Events</span></li>
                    }
                </ul>
            }
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Recent audit events</h5>
                <a asp-action="Audit" class="btn btn-outline-info btn-sm">Full audit log</a>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-sm mb-0">
                    <tbody>
                        @foreach (var a in Model.RecentEvents)
                        {
                            <tr>
                                <td class="text-nowrap text-muted small">@a.TimestampUtc.ToString("MMM dd HH:mm:ss")</td>
                                <td><partial name="_AuditRow" model="a" /></td>
                                <td class="text-truncate" style="max-width: 180px;">@a.UserEmail</td>
                                <td class="text-truncate text-muted small" style="max-width: 200px;">@a.Target</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Latest uploads</h5>
                <a asp-controller="File" asp-action="List" asp-route-all="true" class="btn btn-outline-primary btn-sm">All files</a>
            </div>
            @if (!Model.RecentFiles.Any())
            {
                <p class="text-muted mb-0">No files uploaded.</p>
            }
            else
            {
                <ul class="list-group list-group-flush list-dark">
                    @foreach (var f in Model.RecentFiles)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between"><span class="text-truncate me-2">@f.FileName</span><span class="text-muted small text-nowrap">@FormatHelpers.Bytes(f.SizeBytes)</span></div>
                            <small class="text-muted">@f.OwnerEmail · @f.UploadedAtUtc.ToString("MMM dd HH:mm")</small>
                        </li>
                    }
                </ul>
            }
        </div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const days = @Json.Serialize(Model.Last7Days);
            Chart.defaults.color = '#9aa7b4';
            Chart.defaults.borderColor = '#2c3e50';
            new Chart(document.getElementById('activityChart'), {
                type: 'bar',
                data: {
                    labels: days.map(d => d.label),
                    datasets: [
                        { label: 'Uploads', data: days.map(d => d.uploads), backgroundColor: '#3498db' },
                        { label: 'Downloads', data: days.map(d => d.downloads), backgroundColor: '#1abc9c' },
                        { label: 'Sign-ins', data: days.map(d => d.logins), backgroundColor: '#27ae60' },
                        { label: 'Failed sign-ins', data: days.map(d => d.failedLogins), backgroundColor: '#e74c3c' }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
        })();
    </script>
}
