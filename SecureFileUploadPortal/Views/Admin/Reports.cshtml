@model ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}
<h2 class="page-title">Reports</h2>
<p class="page-subtitle">CSV exports generated on demand from the database (and the CloudTrail bucket when configured). Each export is itself audited.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-action="DownloadReport" asp-route-type="files" class="card h-100 text-decoration-none"><div class="card-body">
            <i class="fas fa-file-csv fa-2x text-primary mb-2"></i>
            <h5 class="card-title">File inventory</h5>
            <p class="text-muted small mb-0">Every stored file with owner, size, type and upload time.</p>
        </div></a>
    </div>
    <div class="col-md-4">
        <a asp-action="DownloadReport" asp-route-type="audit" class="card h-100 text-decoration-none"><div class="card-body">
            <i class="fas fa-shield-halved fa-2x text-success mb-2"></i>
            <h5 class="card-title">Audit trail</h5>
            <p class="text-muted small mb-0">User activity events (latest 50,000) including failures and denials.</p>
        </div></a>
    </div>
    <div class="col-md-4">
        @if (Model.CloudTrailConfigured)
        {
            <a asp-action="DownloadReport" asp-route-type="cloudtrail" class="card h-100 text-decoration-none"><div class="card-body">
                <i class="fas fa-scroll fa-2x text-info mb-2"></i>
                <h5 class="card-title">CloudTrail log index</h5>
                <p class="text-muted small mb-0">Keys, sizes and delivery times of CloudTrail log files.</p>
            </div></a>
        }
        else
        {
            <div class="card h-100 opacity-50"><div class="card-body">
                <i class="fas fa-scroll fa-2x text-info mb-2"></i>
                <h5 class="card-title">CloudTrail log index</h5>
                <p class="text-muted small mb-0">Unavailable – CloudTrail is not configured.</p>
            </div></div>
        }
    </div>
</div>

<div class="card mw-720"><div class="card-body">
    <h5 class="card-title">Storage usage</h5>
    <progress class="storage-meter w-100 @(Model.StoragePercent > 80 ? "meter-danger" : "")" max="100" value="@Model.StoragePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
              aria-label="Storage used">@Model.StoragePercent.ToString("0")%</progress>
    <small class="text-muted">@FormatHelpers.Bytes(Model.StorageBytes) of @Model.StorageQuotaMB MB budget (@Model.StoragePercent.ToString("0.#")%). The budget is informational and set by <code>Storage:StorageQuotaMB</code>.</small>
</div></div>
